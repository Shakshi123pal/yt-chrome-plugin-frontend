{
  "manifest_version": 3,
  "name": "YouTube Comment Sentiment Analyzer",
  "version": "1.0",
  "description": "Analyze YouTube comments using ML backend",

  "action": {
    "default_popup": "popup.html"
  },

  "permissions": ["tabs"],

  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "https://www.googleapis.com/*"
  ]
}
